<!DOCTYPE html>
<html class="dialog">

<head>
	<meta charset="utf-8">
	<title>__MSG_folderPolicyDialog__ - __MSG_extensionName__</title>
	<link rel="stylesheet" href="dialog.css">
	<link rel="stylesheet" href="bs.css">
	<script type="module" src="folder-policy.js"></script>
</head>

<body>
	<div class="dialog-content bg-light p-3">
		<div class="card">
			<div class="card-header">
				<h5 class="card-title">__MSG_folderPolicyTitle__</h5>
				<h6 class="card-subtitle text-muted folder-info"><small class="path"></small></h6>
			</div>
			<form class="flex-box card-body" method="get" action="#">
				<div class="card-text">
					<div class="form-check mt-1 mb-1">
						<input class="form-check-input" name="inherit" type="checkbox" id="chkInherit" checked>
						<label class="form-check-label" for="chkInherit">__MSG_chkInherit__</label>
					</div>
					{{> policy-editor folderPolicy=1}}
				</div>
			</form>

		</div>
		{{> dialog-buttons}}
	</div>
</body>

</html>